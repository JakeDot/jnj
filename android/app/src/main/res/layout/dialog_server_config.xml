<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E2E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_title_server_config"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_subtitle_server_config"
            android:textColor="#A6ADC8"
            android:textSize="12sp" />

        <!-- Hosting Mode Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_select_hosting_mode"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgHostingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbSelfHosted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_self_hosted"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbRemoteServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_remote_server"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbNativeFlutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_native_flutter"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <!-- Remote Server Settings Container -->
        <LinearLayout
            android:id="@+id/containerRemoteSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_remote_server_url"
                app:hintTextColor="#89B4FA"
                app:boxStrokeColor="#89B4FA">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRemoteUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPresetEmulator"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10.0.2.2:8080"
                    android:textColor="#89B4FA"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnPresetLocalhost"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="127.0.0.1:8080"
                    android:textColor="#89B4FA"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnPresetGitHubPages"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GitHub Pages"
                    android:textColor="#00E5FF"
                    android:textSize="10sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnTestConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_test_connection"
                android:backgroundTint="#89B4FA"
                android:textColor="#181825" />

            <TextView
                android:id="@+id/tvTestStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#A6ADC8"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoFallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/switch_auto_fallback"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Local Server Port Settings -->
        <LinearLayout
            android:id="@+id/containerLocalSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_local_port"
                app:hintTextColor="#00E5FF"
                app:boxStrokeColor="#00E5FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocalPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel"
                android:textColor="#A6ADC8" />

            <Button
                android:id="@+id/btnSaveApply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_save_apply"
                android:backgroundTint="#00E5FF"
                android:textColor="#181825" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
